# --- Secrets (NEVER commit) ---
API_Keys
*.key
*.pem
.env
.env.*
!.env.example

# --- Large data and runtime outputs (see docs/DATA_AVAILABILITY.md) ---
data/
logs/
bot_state/
.tmp/
tmp/
experiments/

# --- Model weights and search output ---
# Large/private training outputs remain ignored. The five small public-evidence
# checkpoints below are an explicit exception and are required for mini inference.
artifacts/**/*.pkl
artifacts/**/*.npy
artifacts/**/*.pt
artifacts/**/*.pth
artifacts/**/*.zip
artifacts/**/*.zst
artifacts/**/*.parquet
!artifacts/evaluation_repro_v2/checkpoints/*.pt

